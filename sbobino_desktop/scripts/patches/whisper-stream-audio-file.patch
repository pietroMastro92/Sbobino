+bool load_replay_wav(const char * path, int sample_rate, std::vector<float> & samples) {
+    std::ifstream file(path, std::ios::binary);
+    if (!file) {
+        fprintf(stderr, "audio replay: failed to open '%s'\n", path);
+        return false;
+    }
+
+    char riff[4] = {};
+    char wave[4] = {};
+    uint32_t riff_size = 0;
+    file.read(riff, sizeof(riff));
+    file.read(reinterpret_cast<char *>(&riff_size), sizeof(riff_size));
+    file.read(wave, sizeof(wave));
+    if (!file || std::string(riff, 4) != "RIFF" || std::string(wave, 4) != "WAVE") {
+        fprintf(stderr, "audio replay: '%s' is not a RIFF/WAVE file\n", path);
+        return false;
+    }
+
+    bool have_format = false;
+    bool have_data = false;
+    uint16_t format = 0;
+    uint16_t channels = 0;
+    uint16_t bits_per_sample = 0;
+    uint32_t wav_sample_rate = 0;
+    std::vector<uint8_t> data;
+    while (file && (!have_format || !have_data)) {
+        char chunk_id[4] = {};
+        uint32_t chunk_size = 0;
+        file.read(chunk_id, sizeof(chunk_id));
+        file.read(reinterpret_cast<char *>(&chunk_size), sizeof(chunk_size));
+        if (!file) {
+            break;
+        }
+        if (std::string(chunk_id, 4) == "fmt ") {
+            if (chunk_size < 16) {
+                fprintf(stderr, "audio replay: invalid fmt chunk in '%s'\n", path);
+                return false;
+            }
+            uint32_t byte_rate = 0;
+            uint16_t block_align = 0;
+            file.read(reinterpret_cast<char *>(&format), sizeof(format));
+            file.read(reinterpret_cast<char *>(&channels), sizeof(channels));
+            file.read(reinterpret_cast<char *>(&wav_sample_rate), sizeof(wav_sample_rate));
+            file.read(reinterpret_cast<char *>(&byte_rate), sizeof(byte_rate));
+            file.read(reinterpret_cast<char *>(&block_align), sizeof(block_align));
+            file.read(reinterpret_cast<char *>(&bits_per_sample), sizeof(bits_per_sample));
+            if (chunk_size > 16) {
+                file.seekg(static_cast<std::streamoff>(chunk_size - 16), std::ios::cur);
+            }
+            have_format = true;
+        } else if (std::string(chunk_id, 4) == "data") {
+            data.resize(chunk_size);
+            file.read(reinterpret_cast<char *>(data.data()), static_cast<std::streamsize>(data.size()));
+            have_data = true;
+        } else {
+            file.seekg(static_cast<std::streamoff>(chunk_size), std::ios::cur);
+        }
+        if (chunk_size & 1U) {
+            file.seekg(1, std::ios::cur);
+        }
+    }
+
+    if (!file || !have_format || !have_data || format != 1 || channels != 1 ||
+        wav_sample_rate != static_cast<uint32_t>(sample_rate) || bits_per_sample != 16 ||
+        data.size() % sizeof(int16_t) != 0) {
+        fprintf(stderr, "audio replay: '%s' must be PCM16 mono %d Hz\n", path, sample_rate);
+        return false;
+    }
+
+    samples.resize(data.size() / sizeof(int16_t));
+    for (size_t i = 0; i < samples.size(); ++i) {
+        int16_t value = 0;
+        memcpy(&value, data.data() + i * sizeof(value), sizeof(value));
+        samples[i] = static_cast<float>(value) / 32768.0f;
+    }
+    return !samples.empty();
+}
